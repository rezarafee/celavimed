@{
    ViewData["Title"] = "رزرو آنلاین نوبت";
    var next = ViewBag.Next as Celavimed.Controllers.NextFreeSlot;
}
<section class="hero">
    <div class="wrap hero-grid">
        <div class="hero-copy">
            <h1>نوبت‌تان را<br />خودتان انتخاب کنید</h1>
            <p>ساعت‌های آزاد پزشکان را ببینید و همین‌جا رزرو کنید. منشی مرکز برای تایید نهایی با شما تماس می‌گیرد.</p>
        </div>
        @if (next != null)
        {
            var (_, nm, nd) = Jalali.Parts(next.Date);
            var dayWord = next.Date == Clock.Today ? "امروز" : next.Date == Clock.Today.AddDays(1) ? "فردا" : Jalali.DayName(next.Date.DayOfWeek);
            <aside class="next-arch" aria-labelledby="next-title">
                <p id="next-title">نزدیک‌ترین نوبت آزاد</p>
                <b class="next-day">@dayWord</b>
                <span class="next-date">@nd @Jalali.MonthNames[nm - 1]، ساعت @Jalali.Time(next.Start)</span>
                <span class="next-doc">@next.DoctorName</span>
                <button type="button" class="btn btn-quartz" id="quick-pick" data-doctor="@next.DoctorId" data-date="@next.Date.ToString("yyyy-MM-dd")" data-time="@Jalali.Time(next.Start)">همین نوبت را می‌خواهم</button>
            </aside>
        }
    </div>
</section>

<section class="booking">
    <div class="wrap">
        <div class="panel" id="booking" data-doctors="@ViewBag.DoctorsJson">
            <ol class="steps" aria-label="مراحل رزرو">
                <li data-step="1" class="is-active"><span class="num">۱</span><span>پزشک<span class="step-val" data-val="doctor"></span></span></li>
                <li data-step="2"><span class="num">۲</span><span>روز و ساعت<span class="step-val" data-val="time"></span></span></li>
                <li data-step="3"><span class="num">۳</span><span>مشخصات شما</span></li>
            </ol>

            <!-- ۱. انتخاب پزشک -->
            <div class="stage" data-stage="1">
                <div class="stage-title">
                    <div>
                        <h2>نزد کدام پزشک می‌خواهید بیایید؟</h2>
                        <p>روی پزشک بزنید تا روزهای کاری‌اش را ببینید.</p>
                    </div>
                </div>
                @if ((int)ViewBag.DoctorCount == 0)
                {
                    <div class="slots-empty">@Ui.Icon("calendar-x")رزرو آنلاین فعلا فعال نیست. لطفا تلفنی تماس بگیرید.</div>
                }
                <div class="doctors" id="doctor-list"></div>
            </div>

            <!-- ۲. روز و ساعت -->
            <div class="stage" data-stage="2" hidden>
                <div class="stage-title">
                    <div>
                        <h2>یک روز را انتخاب کنید</h2>
                        <p>روزهای صورتی، ساعت آزاد دارند.</p>
                    </div>
                </div>
                <div class="picker">
                    <div class="jcal" id="cal">
                        <div class="jcal-head">
                            <button type="button" class="btn btn-ghost btn-icon" data-cal="prev" aria-label="ماه قبل">@Ui.Icon("chevron-right")</button>
                            <span class="jcal-title" aria-live="polite"></span>
                            <button type="button" class="btn btn-ghost btn-icon" data-cal="next" aria-label="ماه بعد">@Ui.Icon("chevron-left")</button>
                        </div>
                        <div class="jcal-grid"></div>
                        <div class="legend">
                            <span><i style="background:var(--quartz-200)"></i>نوبت آزاد دارد</span>
                            <span><i style="background:repeating-linear-gradient(-45deg,#F3EFF4,#F3EFF4 3px,#E4DDE7 3px,#E4DDE7 6px)"></i>تکمیل</span>
                            <span><i style="background:var(--plum-900)"></i>انتخاب شما</span>
                        </div>
                    </div>
                    <div id="slots" aria-live="polite">
                        <div class="slots-empty">@Ui.Icon("calendar-days")یک روز صورتی را از تقویم انتخاب کنید تا ساعت‌های آزادش را ببینید.</div>
                    </div>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn-ghost" data-go="1">@Ui.Icon("arrow-right", "icon-sm")تغییر پزشک</button>
                    <button type="button" class="btn btn-dark btn-lg" data-go="3" disabled id="to-details"><span>ادامه</span>@Ui.Icon("arrow-left", "icon-sm")</button>
                </div>
            </div>

            <!-- ۳. مشخصات -->
            <div class="stage" data-stage="3" hidden>
                <div class="details">
                    <form id="book-form" novalidate>
                        <div class="stage-title"><div><h2>مشخصات شما</h2><p>شماره را درست وارد کنید؛ منشی با همین شماره تماس می‌گیرد.</p></div></div>
                        <div class="field">
                            <label for="b-name">نام و نام خانوادگی</label>
                            <input class="input" id="b-name" name="name" autocomplete="name" required maxlength="120" />
                        </div>
                        <div class="field">
                            <label for="b-mobile">شماره موبایل</label>
                            <input class="input ltr-input" id="b-mobile" name="mobile" inputmode="tel" autocomplete="tel" placeholder="09xxxxxxxxx" required maxlength="14" />
                        </div>
                        <div class="field" id="svc-field">
                            <span class="label">برای چه خدمتی می‌آیید؟</span>
                            <div class="svc-list" id="svc-list"></div>
                        </div>
                        <div class="hp" aria-hidden="true"><label>وبسایت<input name="website" tabindex="-1" autocomplete="off" /></label></div>
                        <div class="alert alert-error form-error" id="form-error" hidden></div>
                        <div class="actions">
                            <button type="button" class="btn btn-ghost" data-go="2">@Ui.Icon("arrow-right", "icon-sm")تغییر ساعت</button>
                            <button type="submit" class="btn btn-dark btn-lg" id="submit-btn">ثبت نوبت</button>
                        </div>
                    </form>
                    <aside class="summary" aria-label="خلاصه‌ی نوبت">
                        <h3>نوبت شما</h3>
                        <dl>
                            <div><dt>پزشک</dt><dd class="big" data-sum="doctor"></dd></div>
                            <div><dt>روز</dt><dd data-sum="date"></dd></div>
                            <div><dt>ساعت</dt><dd data-sum="time"></dd></div>
                        </dl>
                    </aside>
                </div>
            </div>

            <!-- پایان -->
            <div class="stage done" data-stage="4" hidden>
                <div class="done-arch">@Ui.Icon("calendar-check")</div>
                <h2>نوبت شما ثبت شد</h2>
                <p>منشی مرکز به‌زودی برای تایید نهایی با شما تماس می‌گیرد. کد پیگیری را نگه دارید.</p>
                <div class="ticket-box"><small>کد پیگیری</small><b id="done-code"></b></div>
                <p class="done-meta" id="done-meta"></p>
                <div style="margin-top:28px"><button type="button" class="btn btn-outline" id="again">رزرو نوبت دیگر</button></div>
            </div>
        </div>
    </div>
</section>


@section Scripts {
    <script src="~/js/jalali.js" asp-append-version="true"></script>
    <script src="~/js/booking.js" asp-append-version="true"></script>
}
