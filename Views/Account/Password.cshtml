@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "تغییر رمز عبور";
    ViewData["Nav"] = "password";
}
<div class="card card-pad" style="max-width:480px">
    <h2 style="font-size:19px;margin-bottom:6px">تغییر رمز عبور</h2>
    <p class="muted" style="font-size:14px;margin-bottom:20px">رمز جدید حداقل ۸ کاراکتر و شامل یک عدد باشد.</p>
    @if (ViewBag.Error is string err)
    {
        <div class="alert alert-error">@err</div>
    }
    <form asp-antiforgery="true" method="post" action="/account/password">
        <div class="field"><label for="c">رمز فعلی</label><input class="input ltr-input" id="c" type="password" name="current" autocomplete="current-password" required /></div>
        <div class="field"><label for="n">رمز جدید</label><input class="input ltr-input" id="n" type="password" name="next" autocomplete="new-password" required minlength="8" /></div>
        <div class="field"><label for="r">تکرار رمز جدید</label><input class="input ltr-input" id="r" type="password" name="confirm" autocomplete="new-password" required /></div>
        <button class="btn btn-primary" type="submit">@Ui.Icon("key-round")ذخیره‌ی رمز جدید</button>
    </form>
</div>
