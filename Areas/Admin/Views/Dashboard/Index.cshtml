@model DashboardVm
@{
    var name = User.FindFirst("FullName")?.Value ?? "";
}
<div class="page-head">
    <div>
        <h2>سلام @name</h2>
        <p>امروز @Jalali.Long(Clock.Today) است و @Model.TodayTotal بیمار نوبت دارند.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline" href="/admin/appointments/new">@Ui.Icon("calendar-plus")نوبت تلفنی</a>
        <a class="btn btn-primary" href="/admin/board">@Ui.Icon("square-kanban")مراحل امروز</a>
    </div>
</div>

<section class="journey" aria-labelledby="journey-title">
    <div class="journey-head">
        <h3 id="journey-title">بیماران امروز در هر مرحله</h3>
        <span>@Model.TodayDone نفر از @Model.TodayTotal نفر کارشان تمام شده</span>
    </div>
    <ol class="journey-steps">
        @foreach (var (stage, count) in Model.StageCounts)
        {
            <li style="--c:@stage.Color" class="@(count == 0 ? "is-empty" : "")">
                <a href="/admin/board">
                    <span class="journey-arch">@Ui.Icon(stage.Icon)</span>
                    <b>@count</b>
                    <span>@stage.Name</span>
                </a>
            </li>
        }
    </ol>
</section>

<div class="grid" style="grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);" id="dash-grid">
    <section class="card">
        <div class="card-head">
            <h3>نوبت‌های امروز <span class="count-chip">@Model.TodayTotal</span></h3>
            <a class="btn btn-ghost btn-sm" href="/admin/board">مشاهده‌ی مراحل @Ui.Icon("chevron-left", "icon-sm")</a>
        </div>
        @if (Model.Today.Count == 0)
        {
            <div class="empty">@Ui.Icon("calendar-x")<b>امروز نوبتی ثبت نشده</b>رزروهای آنلاین اینجا ظاهر می‌شوند.</div>
        }
        else
        {
            <ul class="timeline-list">
                @foreach (var a in Model.Today)
                {
                    <li>
                        <span class="tl-time">@Jalali.Time(a.StartTime)</span>
                        <a class="tl-who" href="/admin/appointments/@a.Id" style="color:inherit">
                            <b>@a.Patient.FullName</b>
                            <span>@a.Doctor.FullName@(a.Service != null ? " · " + a.Service.Name : "")</span>
                        </a>
                        <span class="stage-tag" style="--c:@a.Stage.Color">@a.Stage.Name</span>
                    </li>
                }
            </ul>
        }
    </section>

    <div class="grid" style="align-content:start">
        <section class="card card-pad facts">
            <div><b>@Model.UpcomingWeek</b><span>نوبت در هفت روز آینده</span></div>
            <div><b>@Model.NewOnline24h</b><span>رزرو جدید در ۲۴ ساعت گذشته</span></div>
        </section>

        <section class="card">
            <div class="card-head">
                <h3>منتظر تایید تلفنی <span class="count-chip">@Model.PendingConfirm</span></h3>
                <a class="btn btn-ghost btn-sm" href="/admin/appointments?view=pending">همه</a>
            </div>
            @if (Model.ToConfirm.Count == 0)
            {
                <div class="empty" style="padding:28px">@Ui.Icon("circle-check")همه‌ی رزروها تایید شده‌اند.</div>
            }
            else
            {
                <ul class="timeline-list">
                    @foreach (var a in Model.ToConfirm)
                    {
                        <li style="grid-template-columns: 1fr auto">
                            <a class="tl-who" href="/admin/appointments/@a.Id" style="color:inherit">
                                <b>@a.Patient.FullName</b>
                                <span>@Jalali.DayMonth(a.Date) · ساعت @Jalali.Time(a.StartTime) · @a.Doctor.FullName</span>
                            </a>
                            <a class="btn btn-outline btn-sm btn-icon" href="tel:@a.Patient.Mobile" title="تماس" aria-label="تماس با @a.Patient.FullName">@Ui.Icon("phone", "icon-sm")</a>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</div>
<style>
    @@media (max-width: 1100px) { #dash-grid { grid-template-columns: 1fr !important; } }
</style>
