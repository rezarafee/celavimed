@model List<Doctor>
@{ var canEdit = (bool)ViewBag.CanEdit; }
<div class="page-head">
    <div>
        <h2>پزشکان</h2>
        <p>مشخصات، عکس، خدمات و منشی‌های هر پزشک.</p>
    </div>
    @if (canEdit)
    {
        <div class="page-actions"><a class="btn btn-primary" href="/admin/doctors/new">@Ui.Icon("plus")پزشک جدید</a></div>
    }
</div>

@if (Model.Count == 0)
{
    <div class="card empty">@Ui.Icon("stethoscope")<b>هنوز پزشکی ثبت نشده</b>@(canEdit ? "با دکمه‌ی «پزشک جدید» اولین پزشک را اضافه کنید." : "پزشکی به شما سپرده نشده است.")</div>
}
else
{
    <div class="doc-grid">
        @foreach (var d in Model)
        {
            var slots = d.WeeklySchedules.Where(w => w.IsActive).Sum(SlotService.CountSlots);
            var days = d.WeeklySchedules.Where(w => w.IsActive).Select(w => w.DayOfWeek).Distinct().Count();
            <article class="card doc-card">
                <div class="doc-card-top">
                    <partial name="_DocPhoto" model="(d.PhotoPath, d.FullName, (string?)null)" />
                    <div style="min-width:0">
                        <h3>@d.FullName</h3>
                        <p class="muted">@(d.Headline ?? "بدون عنوان تخصصی")</p>
                        <div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap">
                            @if (d.IsActive) { <span class="pill pill-green pill-dot">فعال</span> } else { <span class="pill pill-gray pill-dot">غیرفعال</span> }
                            <span class="pill pill-orchid">@days روز · @slots نوبت در هفته</span>
                        </div>
                    </div>
                </div>
                <div class="doc-card-tags">
                    @foreach (var s in d.Services.Select(x => x.Service).OrderBy(s => s.SortOrder))
                    {
                        <span class="pill pill-gray">@s.Name</span>
                    }
                    @if (d.Services.Count == 0) { <span class="faint" style="font-size:13px">خدمتی انتخاب نشده</span> }
                </div>
                <div class="doc-card-foot">
                    <a class="btn btn-outline btn-sm" href="/admin/schedules/@d.Id">@Ui.Icon("calendar-days", "icon-sm")برنامه‌ی کاری</a>
                    @if (canEdit)
                    {
                        <a class="btn btn-ghost btn-sm" href="/admin/doctors/@d.Id/edit">@Ui.Icon("pencil", "icon-sm")ویرایش</a>
                    }
                    @if (d.Secretaries.Count > 0)
                    {
                        <span class="faint" style="font-size:12.5px;margin-inline-start:auto;align-self:center" title="منشی‌ها">@string.Join("، ", d.Secretaries.Select(s => s.User.FullName))</span>
                    }
                </div>
            </article>
        }
    </div>
}
